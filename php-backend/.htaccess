DirectoryIndex index.html index.php
Options -Indexes

AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass Authorization and X-Auth-Token headers to PHP FastCGI
  SetEnvIfNoCase ^Authorization$ "(.+)" HTTP_AUTHORIZATION=$1
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  SetEnvIfNoCase ^X-Auth-Token$ "(.+)" HTTP_X_AUTH_TOKEN=$1

  # Explicitly allow api.php and static assets to execute/serve directly
  RewriteCond %{REQUEST_URI} api\.php [NC,OR]
  RewriteCond %{REQUEST_URI} \.(php|js|css|png|jpg|jpeg|webp|gif|svg|woff2|woff|ttf|json|ico)$ [NC]
  RewriteRule ^ - [L]

  # Do not rewrite if physical file or directory exists
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback for router navigation (excluding api.php)
  RewriteCond %{REQUEST_URI} !api\.php [NC]
  RewriteRule ^ index.html [L]
</IfModule>

# Block direct web access to sensitive configuration, credentials, SQL and env files
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op]|env|git.*|md)$|config\.php|db_credentials\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Strict CORS headers via Apache when Origin matches whitelist
<IfModule mod_headers.c>
  SetEnvIfNoCase Origin "^(https?://(toghrool\.ir|localhost(:[0-9]+)?)|capacitor://localhost)$" CORS_ALLOWED_ORIGIN=$0
  Header set Access-Control-Allow-Origin "%{CORS_ALLOWED_ORIGIN}e" env=CORS_ALLOWED_ORIGIN
  Header set Access-Control-Allow-Credentials "true" env=CORS_ALLOWED_ORIGIN
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Auth-Token, X-Requested-With"
  Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
  Header append Vary Origin

  <FilesMatch "\.(html|htm|json|php)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, post-check=0, pre-check=0"
    Header always set Pragma "no-cache"
    Header always set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
  </FilesMatch>

  <FilesMatch "\.(js|css)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
